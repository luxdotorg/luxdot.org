{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luxdot.org/schema/luxdot-research-standard-v0.1.json",
  "title": "LuxDot Research Standard — Theoretical Preview",
  "description": "A non-enforcing, non-scoring schema for future LuxDot research-node review.",
  "type": "object",
  "required": [
    "mode",
    "node",
    "question",
    "claims",
    "sources",
    "review"
  ],
  "properties": {
    "mode": {
      "const": "theoretical-preview"
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "enum": [
            "historical",
            "religious-textual",
            "memory-testimony",
            "symbolic-exploratory",
            "mixed"
          ]
        }
      }
    },
    "question": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string"
          },
          "epistemic_status": {
            "enum": [
              "strongly-supported",
              "probable",
              "open-hypothesis",
              "weak",
              "currently-rejected",
              "not-reviewed"
            ]
          },
          "supporting_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "counter_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "alternative_explanations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "falsification_condition": {
            "type": "string"
          },
          "review_note": {
            "type": "string"
          }
        },
        "required": [
          "claim",
          "epistemic_status"
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string"
          },
          "class": {
            "enum": [
              "A-primary",
              "B-academic",
              "C-reference",
              "D-contemporary-institutional",
              "E-research-lead"
            ]
          },
          "independent": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "const": "not-enforced"
        },
        "last_reviewed": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "method_version": {
          "const": "0.1-preview"
        }
      }
    },
    "report_fingerprint": {
      "type": "object",
      "properties": {
        "enabled": {
          "const": false
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}